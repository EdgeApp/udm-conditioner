network:
  version: 2
  renderer: networkd
  ethernets:
    eth0:
      dhcp4: false
      dhcp6: false
      optional: true
  bridges:
    br0:
      interfaces: [eth0]
      macaddress: @@ETH0_MAC@@
      dhcp4: true
      dhcp6: false
      optional: true
      parameters:
        stp: false
        forward-delay: 0
