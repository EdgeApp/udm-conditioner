# Copy to deploy/secrets.env (gitignored) and fill in. Values left blank are
# auto-detected on the Pi where possible.
WPA_PASSPHRASE=        # shared by both access points
SSID1=test-a           # AP on AP1_IFACE, channel 149
SSID2=test-b           # AP on AP2_IFACE, channel 36
AP1_IFACE=             # required: a USB radio's wlx* name (ls /sys/class/net | grep ^wlx)
AP2_IFACE=             # required: the other one
ETH0_MAC=              # blank: read from /sys/class/net/eth0/address
HOSTNAME=conditioner.example
HOST_IP=               # blank: br0's IPv4 address, else eth0's
